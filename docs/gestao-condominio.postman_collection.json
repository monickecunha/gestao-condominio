              "  const queue = pm.response.json().filter(b => b.unitId === Number(pm.collectionVariables.get(\"rejectUnitId\")));",
              "  pm.expect(queue.map(b => [b.bindingId, b.status])).to.eql([[Number(pm.collectionVariables.get(\"secondRequestId\")), \"PENDING\"]]);",
              "});"
            ]
          }
