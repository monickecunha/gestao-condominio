    {
      "name": "23. Opcional: síndico de outro condomínio tenta rejeitar",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/bindings/{{firstRequestId}}/reject",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{otherManagerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "description": "Executar somente com fixture de dois condomínios no mesmo servidor e JWT válido do outro síndico. No setup padrão este passo é pulado; a suíte H2 cobre este cenário."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get(\"otherManagerToken\")) pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
